# ---------------------------------------------------------------------------
# Knox Solar Gateway — backend configuration
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

APP_TIMEZONE=Asia/Karachi

# Encrypts stored ShineMonitor passwords and binds gateway sessions.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Gateway Bearer session lifetime in milliseconds (default 7 days).
# AUTH_SESSION_TTL_MS=604800000

# HTTP port the API listens on.
PORT=3000

# Comma-separated browser origins allowed to call the API (no trailing slash).
# Must match the frontend Origin header exactly, e.g.:
CORS_ORIGINS=

# Password required to read/write inverter settings via /api/v1/controls/*
# Must match CONTROLS_PASSWORD on the frontend Vercel project.
CONTROLS_PASSWORD=
CONTROLS_SECRET=

# PostgreSQL for users, sessions, and daily energy totals
# (Neon, Supabase, Vercel Postgres, etc.)
# Required so logins can be stored and ShineMonitor tokens can be refreshed
# across serverless invocations.
DATABASE_URL=

# Secret for scheduled snapshots (Vercel Cron sends Authorization: Bearer CRON_SECRET)
CRON_SECRET=

# ---------------------------------------------------------------------------
# Camera (optional). Requires ffmpeg on the host AND network reachability to
# the camera, so this is normally only enabled on an on-premise deployment.
# ---------------------------------------------------------------------------
# Hikvision format: rtsp://USER:PASS@CAMERA_IP:554/streaming/Channels/102
CAMERA_RTSP=
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
CAMERA_FPS=10
CAMERA_QUALITY=6
CAMERA_MAX_STREAMS=3

# ---------------------------------------------------------------------------
# Upstream overrides (change only if ShineMonitor rejects the defaults)
# ---------------------------------------------------------------------------
# SHINE_UPSTREAM_URL=http://android.shinemonitor.com/public/
# SHINE_COMPANY_KEY=bnrl_frRFjEz8Mkn
# SHINE_TIMEOUT_MS=20000
# SHINE_LOCALE=en_US
