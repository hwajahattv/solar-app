# ---------------------------------------------------------------------------
# Knox Solar Gateway — backend configuration
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

APP_TIMEZONE=Asia/Karachi
# ShineMonitor account. The gateway signs in once and shares the session with
# every client, so no browser or mobile app ever handles these credentials.
SHINE_USR=
SHINE_PWD=

# HTTP port the API listens on.
PORT=3000

# Comma-separated browser origins allowed to call the API (no trailing slash).
# Must match the frontend Origin header exactly, e.g.:
# CORS_ORIGINS=http://localhost:4200,https://solar-app-frontend-theta.vercel.app
CORS_ORIGINS=http://localhost:4200,https://solar-app-frontend-theta.vercel.app

# ---------------------------------------------------------------------------
# Camera (optional). Requires ffmpeg on the host AND network reachability to
# the camera, so this is normally only enabled on an on-premise deployment.
# ---------------------------------------------------------------------------
# Hikvision format: rtsp://USER:PASS@CAMERA_IP:554/streaming/Channels/102
CAMERA_RTSP=
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
CAMERA_FPS=10
CAMERA_QUALITY=6
CAMERA_MAX_STREAMS=3

# ---------------------------------------------------------------------------
# Upstream overrides (change only if ShineMonitor rejects the defaults)
# ---------------------------------------------------------------------------
# SHINE_UPSTREAM_URL=http://android.shinemonitor.com/public/
# SHINE_COMPANY_KEY=bnrl_frRFjEz8Mkn
# SHINE_TIMEOUT_MS=20000
# SHINE_LOCALE=en_US
